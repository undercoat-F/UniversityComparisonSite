# CSV出力ディレクトリ
CSV_OUTPUT_DIR=db/csv_output

#NeonDB接続設定
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=

DB_READUSER=readonly
DB_READPASSWORD=

#DB 接続設定
PARENT_DB_OWNER_CONNECTION=
PARENT_DB_READONLY_CONNECTION=
# API用（DBのreadonlyロール）
PARENT_DB_HOST=
PARENT_DB_NAME=
PARENT_DB_USER=
PARENT_DB_PASSWORD=
PARENT_DB_PORT=

#Observer設定用環境変数
BRAVE_API_KEY=
OBSERVE_LOG_ENABLED=
OBSERVE_LOG_SCHEMA_PATH=
SEARCH_DISCOVERY_QUERY_LIMIT=

# Redis設定(重複排除・レート制御用)
REDIS_URL=redis://localhost:6379/0
# 重複排除キーのTTL(秒単位、既定30日)
DEDUP_TTL_SECONDS=2592000

# SQS設定(分散クロールのURLタスクキュー)
SQS_QUEUE_URL=
AWS_REGION=ap-northeast-1

# スキップする時間の設定（月単位）
# ETL_RECENT_SKIP_MONTHS=6
# ETL_SITEMAP_SEED_MAX_SECONDS=60
# ETL_SITEMAP_SEED_MAX_SITEMAPS=100#１つのWORKERが持つSITEMAP数上限

#テストに使用するDB接続の環境変数(1だとObserverのテストが実行される CI時は情報漏洩対策として0にする)
#未指定時は0扱い
RUN_DB_TARGET_CHECK=

#DBテーブル集約
ETL_SCHEMA=etl
OBSERVER_SCHEMA=observer
PUBLIC_SCHEMA=public

# DBテーブル名集約
SEED_URLS_TABLE=observer.seed_urls
SEED_SEARCH_RUNS_TABLE=observer.seed_search_runs
SEED_OBSERVE_RUNS_TABLE=observer.seed_observe_runs
SEED_OBSERVE_RESULTS_TABLE=observer.seed_observe_results
CRAWL_RUNS_TABLE=etl.crawl_runs
CRAWL_QUEUE_STATE_TABLE=etl.crawl_queue_state
CRAWL_ATTEMPTS_TABLE=etl.crawl_attempts
CRAWL_EDGES_TABLE=etl.crawl_edges
CRAWL_FAILURES_TABLE=etl.crawl_failures
CRAWL_TAG_KEYWORD_HITS_TABLE=etl.crawl_tag_keyword_hits
CRAWL_DOMAIN_TAG_SCORES_TABLE=etl.crawl_domain_tag_scores
CRAWL_TAG_CLASS_COUNTS_TABLE=etl.crawl_tag_class_counts
CRAWL_DOMAIN_CLASS_COUNTS_TABLE=etl.crawl_domain_class_counts
CRAWL_RESOURCE_SAMPLES_TABLE=etl.crawl_resource_samples

# リソース監視設定
# CSVへのサンプリング間隔(秒、既定5秒)
# ETL_RESOURCE_MONITOR_INTERVAL_SEC=5
# DBへの書き込み間隔(秒、既定30秒。CSVより粗く間引いて書き込み回数を抑える)
# ETL_RESOURCE_DB_INTERVAL_SEC=30
# DB書き込みを無効化したい場合は0/false
# ETL_RESOURCE_DB_ENABLED=1
UNIVERSITIES_TABLE=public.universities
DEGREE_PROGRAMS_TABLE=public.degree_programs
TUITION_PATTERNS_TABLE=public.tuition_patterns
PROGRAM_TUITION_MAP_TABLE=public.program_tuition_map

#キューの最大待機数(全SiteState共通の list 制限)
ETL_MAXPENDING_QUEUE_ITEMS=

# プロセスRSSが上限に達したら新規workerを待機し、再開値以下で再開する
ETL_MEMORY_HIGH_WATERMARK_MB=350
ETL_MEMORY_RESUME_WATERMARK_MB=300
ETL_MEMORY_CHECK_INTERVAL_SEC=5
# メモリ圧迫が解消しない場合の診断終了上限（0 は無効）
ETL_MEMORY_PRESSURE_MAX_WAIT_SEC=300
# ドメインごとに保持する sitemap 候補URL数の上限
ETL_SITEMAP_SEED_MAX_CANDIDATES_PER_DOMAIN=500

# タイムアウト設定（秒）
# dispatcher 全体上限（0 は無効）
ETL_DISPATCHER_TIMEOUT_SEC=43200
# 1 回の worker 実行待ち上限
ETL_WORKER_TIMEOUT_SEC=120
# httpx AsyncClient のリクエストタイムアウト
ETL_HTTPX_TIMEOUT_SEC=30
# requests fallback のタイムアウト
ETL_REQUESTS_TIMEOUT_SEC=30
# robots.txt 取得のタイムアウト
ETL_REQUESTS_ROBOTS_TIMEOUT_SEC=10
# sitemap 取得のタイムアウト
ETL_REQUESTS_SITEMAP_TIMEOUT_SEC=15
# RobotFileParser.read の待機上限
ETL_ROBOTS_READ_TIMEOUT_SEC=20

# 同一ドメインで tag_class_count を記録する URL 数の上限
ETL_TAG_CLASS_LOG_URL_LIMIT_PER_DOMAIN=20
QUEUE_LOG_ENABLED=0
# _____

# .env に実ドメインを設定
DOMAIN=degrees.example.com